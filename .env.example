# Single-tenant credentials (stdio, and HTTP only when AUTH_MODE=env).
# The gateway-mode compose service does not load DOMOTZ_API_KEY. Do not add
# it to that service's environment or via env_file.
DOMOTZ_API_KEY=
# Region is not a credential. Gateway compose may interpolate DOMOTZ_REGION.
DOMOTZ_REGION=us-east-1

# stdio (default) or http
MCP_TRANSPORT=stdio

# Bind address when MCP_TRANSPORT=http. When unset, the HTTP server binds
# 127.0.0.1. The container image sets 0.0.0.0 and requires CONDUIT_S2S_SECRET.
# MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8080

# Required to start the HTTP transport. Leave this empty. The process logs an
# error and exits non-zero when this is empty or a known placeholder (so a
# copied example cannot forge X-Gateway-S2S). docker compose will not start
# when it is unset. Never commit a real value. The value is never logged.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without
# CONDUIT_S2S_SECRET. The server logs a warning, does not check X-Gateway-S2S,
# and binds 127.0.0.1 only. A non-loopback MCP_HTTP_HOST is ignored and the
# override is logged. A known placeholder secret is still refused.
# MCP_ALLOW_INSECURE_DEV=1

# Credential source for HTTP: env (process environment) or gateway (required
# X-Domotz-API-Key header; no env fallback). The container image and Compose
# service set gateway. Stdio ignores this and reads DOMOTZ_* from the environment.
# AUTH_MODE=gateway

LOG_LEVEL=info
